APP_NAME="Zawsze in Love"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=private

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Zawsze media. Local storage is the default and keeps originals private.
# Set MEDIA_DISK_DRIVER=s3 later for S3-compatible providers such as R2/S3/B2.
ZAWSZE_MEDIA_DISK=media
MEDIA_DISK_DRIVER=local
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_REGION=auto
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_URL=
MEDIA_PATH_STYLE=false

# Gallery/media performance defaults.
ZAWSZE_GALLERY_PAGE_SIZE=24
ZAWSZE_PREVIEW_MAX_EDGE=960
ZAWSZE_PREVIEW_QUALITY=78
ZAWSZE_PREVIEW_MAX_SOURCE_KB=131072
ZAWSZE_UPLOAD_MAX_FILES=50
ZAWSZE_UPLOAD_MAX_KB=51200

# Private couple setup. Keep real values only in backend/.env.
ZAWSZE_SPACE_NAME="Zawsze in Love"
ZAWSZE_RELATIONSHIP_START=
ZAWSZE_USER_ONE_NAME="Ayen Chavez"
ZAWSZE_USER_ONE_EMAIL=ayen@example.test
ZAWSZE_USER_ONE_PASSWORD=change-this-password-1
ZAWSZE_USER_TWO_NAME="Jonalyn Balmores"
ZAWSZE_USER_TWO_EMAIL=jonalyn@example.test
ZAWSZE_USER_TWO_PASSWORD=change-this-password-2
