APP_NAME="Zawsze in Love"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Central production database. Do not use SQLite for the deployed shared site.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zawsze
DB_USERNAME=zawsze
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=private

# The deployed React frontend origin.
SANCTUM_STATEFUL_DOMAINS=example.pages.dev
FRONTEND_URL=https://example.pages.dev

# Shared private media storage. Cloudflare R2 uses the S3-compatible driver.
ZAWSZE_MEDIA_DISK=media
MEDIA_DISK_DRIVER=s3
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_REGION=auto
MEDIA_BUCKET=zawsze-private-media
MEDIA_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_URL=
MEDIA_PATH_STYLE=false

ZAWSZE_GALLERY_PAGE_SIZE=24
ZAWSZE_PREVIEW_MAX_EDGE=960
ZAWSZE_PREVIEW_QUALITY=78
ZAWSZE_PREVIEW_MAX_SOURCE_KB=131072
ZAWSZE_UPLOAD_MAX_FILES=50
ZAWSZE_UPLOAD_MAX_KB=51200

# Keep the real two-user values only in the server's private .env file.
ZAWSZE_SPACE_NAME="Zawsze in Love"
ZAWSZE_RELATIONSHIP_START=
ZAWSZE_USER_ONE_NAME="User One"
ZAWSZE_USER_ONE_EMAIL=user-one@example.com
ZAWSZE_USER_ONE_PASSWORD=
ZAWSZE_USER_TWO_NAME="User Two"
ZAWSZE_USER_TWO_EMAIL=user-two@example.com
ZAWSZE_USER_TWO_PASSWORD=
